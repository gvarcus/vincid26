# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Odoo 16 Configuration
ODOO_URL=https://fexs.mx
ODOO_DB=Productiva

# Email Configuration (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@example.com

# Notification Configuration
NOTIFICATION_EMAIL=soporte.tecnico@varcus.com.mx
# Copias adicionales (separadas por comas, opcional)
# Ejemplo: CC_EMAILS=jefe@ejemplo.com,gerente@ejemplo.com
CC_EMAILS=

# Incident Types (comma-separated)
INCIDENT_TYPES=Soporte técnico,Recursos humanos,Mantenimiento

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=app/static/uploads

# Session Configuration
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=1800

# Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
